<math xmlns="http://www.w3.org/1998/Math/MathML"><mrow><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mo>,</mo><mi>h</mi></mrow><mrow><msub><mrow><mi>ИС</mi></mrow><mrow><mi>пред</mi></mrow></msub><mi> НР(+)</mi></mrow></msubsup><mo>=</mo><mfrac><mrow><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>h</mi></mrow><mrow><msub><mrow><mi>ИС</mi></mrow><mrow><mi>пред</mi></mrow></msub><mi> НР(+)</mi></mrow></msubsup><mo>*</mo><mi>max</mi><mrow><mo>(</mo><mrow><mi>0,</mi><mi>∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mrow><mrow><munder><mo>∑</mo><mrow><mi>p</mi><mn>1</mn></mrow></munder><mrow><mi>max</mi><mrow><mo>(</mo><mrow><mi>0,∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mi>1,</mi><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mfrac></mrow></math>