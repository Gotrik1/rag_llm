<math xmlns="http://www.w3.org/1998/Math/MathML"><mrow><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi> НР</mi></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mrow><mi>0, если </mi><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi> НР</mi></mrow></msubsup><mi>= 0</mi><mi>или </mi><mrow><munder><mo>∑</mo><mrow><mi>p1</mi></mrow></munder><mrow><mi>∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mi>1,</mi><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup><mi>=0</mi></mrow></mrow><mfrac><mrow><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mi>,h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi>НР</mi></mrow></msubsup><mi>*min</mi><mrow><mo>(</mo><mrow><mi>0,∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mi>,h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mrow><mrow><munder><mo>∑</mo><mrow><mi>p1</mi></mrow></munder><mrow><mi>min</mi><mrow><mo>(</mo><mrow><mi>0,∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mi>1,</mi><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mfrac><mi>, если </mi><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi> НР</mi></mrow></msubsup><mi> &lt; 0</mi><mi> </mi><mfrac><mrow><mi>Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi>НР</mi></mrow></msubsup><mi>* </mi><mi>max</mi><mi>⁡</mi><mrow><mo>(</mo><mrow><mi>0,  ∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mrow><mrow><munder><mo>∑</mo><mrow><mi>p</mi><mn>1</mn></mrow></munder><mrow><mi>max</mi><mrow><mo>(</mo><mrow><mi>0,∆</mi><msubsup><mrow><mi>O</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>p</mi><mi>1,</mi><mi>h</mi></mrow><mrow><mi>ИС НР</mi></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mfrac><mi> , если Δ</mi><msubsup><mrow><mi>О</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>h</mi></mrow><mrow><mi>И</mi><msub><mrow><mi>С</mi></mrow><mrow><mi>сальдо</mi></mrow></msub><mi> НР</mi></mrow></msubsup><mo>&gt;</mo><mi> 0,</mi></mrow><mo></mo></mrow></mrow></math>