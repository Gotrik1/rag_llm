<math xmlns="http://www.w3.org/1998/Math/MathML"><mrow><msubsup><mrow><mi>V</mi></mrow><mrow><mi>t</mi></mrow><mrow><mi>УДГ</mi></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mrow><msub><mrow><mo>(</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>план_ВИЭ</mi><mo>,</mo><mi>t</mi><mi>-1</mi></mrow></msub><mo>+</mo><mi>P</mi></mrow><mrow><mi>план_ВИЭ</mi><mo>,</mo><mi>t</mi></mrow></msub><mi>)/2, если </mi><mi>t</mi><mi>∉</mi><mi>T</mi><mi>ив                                                     </mi><mo>(</mo><mi>min</mi><mrow><mo>(</mo><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>ОРР,</mi><mi>t</mi><mi>-1</mi></mrow></msub><mo>;</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>план_ВИЭ</mi><mo>,</mo><mi>t</mi><mi>-1</mi></mrow></msub></mrow><mo>)</mo></mrow><mo>+</mo><mi>min</mi><mrow><mo>(</mo><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>ОРР,</mi><mi>t</mi></mrow></msub><mo>;</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>план_ВИЭ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow><mi>)/2, если </mi><mi>t</mi><mi>∈</mi><mi>T</mi><mi>ив</mi></mrow><mo></mo></mrow><mo>,</mo></mrow></math>