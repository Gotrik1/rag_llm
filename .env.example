# Production Compose configuration. Secrets belong in deploy/secrets/*, never here.
RAG_IMAGE_TAG=local
RAG_DATA_ROOT=./.data/storage

# Public endpoints
RAG_HTTP_PORT=8080
RAG_HTTPS_PORT=8443
RAG_HTTPS_BIND_ADDRESS=0.0.0.0
RAG_SERVER_NAME=rag.example.internal
CORS_ALLOW_ORIGIN=https://rag.example.internal:8443
TLS_CERT_FILE=./deploy/certs/rag.crt
TLS_KEY_FILE=./deploy/certs/rag.key
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# Authentication. Local mode uses an opaque HttpOnly server-side session.
# Set administrator emails before those users register; leave empty if the
# shared library is managed only through migration/operations.
RAG_AUTH_MODE=local
RAG_SESSION_COOKIE_SECURE=true
RAG_SESSION_LIFETIME_HOURS=168
RAG_LOGIN_LOCK_MINUTES=15
RAG_LOCAL_ADMIN_EMAILS=
# Current acceptance environment: every authenticated tester can upload and
# delete shared documents. Set false when shared-library managers are assigned.
RAG_ALL_USERS_MANAGE_GLOBAL_DOCUMENTS=true
# OIDC remains available for a future corporate identity provider.
RAG_OIDC_ISSUER=https://id.example.internal/realms/rag
RAG_OIDC_AUDIENCE=rag-assistant
RAG_OIDC_JWKS_URL=https://id.example.internal/realms/rag/protocol/openid-connect/certs
RAG_OIDC_ROLE_CLAIM=roles
RAG_OIDC_PERMISSION_CLAIM=permissions
BOOTSTRAP_SUPERADMIN_SUBJECT=replace-with-bootstrap-subject

# Storage and queue/cache
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=2gb
RESPONSE_CACHE_MAXMEMORY=256mb
RESPONSE_CACHE_TTL_SECONDS=86400
QDRANT_COLLECTION=rag_docs_v10
RAG_AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_INTERVAL_SECONDS=86400
METRICS_RETENTION=30d

# API/worker concurrency. Ingestion stays single-writer for the shared BM25 snapshot.
WEB_CONCURRENCY=2
RAG_WORKER_CONCURRENCY=1
RAG_DURABLE_GENERATION=true
RAG_INGESTION_QUEUE_NAME=arq:queue:ingestion
RAG_GENERATION_QUEUE_NAME=arq:queue:generation
RAG_GENERATION_CONCURRENCY=4
RAG_GENERATION_TIMEOUT_SECONDS=1800
RAG_GENERATION_WAIT_SECONDS=900

# Local vLLM deployment
VLLM_MODEL=Qwen/Qwen3.8-27B
LLM_MODEL=Qwen/Qwen3.8-27B
EMBED_MODEL=nomic-embed-text
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=5
VLLM_MAX_NUM_BATCHED_TOKENS=8192
LLM_REQUEST_TIMEOUT=900
# No application-imposed output cap; model context limits still apply.
RAG_MAX_OUTPUT_TOKENS=-1

# Local image/document recognition. Enable production vision explicitly.
RAG_VISION_BASE_URL=
RAG_VISION_MODEL=Qwen/Qwen3.8-27B
RAG_FORMULA_OCR_URL=
RAG_VISION_TIMEOUT_SECONDS=180
# Optional document-vision profile: pinned PaddleOCR-VL-1.6 for formula images.
RAG_VISION_IMAGE_TAG=latest
VISION_GPU_MEMORY_FRACTION=0.065
RAG_INGESTION_EMBED_URL=
# Optional for Nvidia hosts after same-model parity and bounded-memory tests:
# COMPOSE_PROFILES=ingestion-gpu
# RAG_INGESTION_EMBED_URL=http://index-embedding:11434
# RAG_EMBED_GPU_IMAGE_TAG=836314277
# Input evidence budget, independent of response length.
RAG_EVIDENCE_MAX_CHARS=36000
# Evidence-first pipeline. Keep off until the corpus-specific release gate passes.
RAG_CORRECTIVE_PIPELINE=off
RAG_REFERENCE_EXPANSION=off
RAG_MAX_ADDITIONAL_SEARCH_ROUNDS=2
# Optional internal planning/review experiment; final answers remain non-thinking.
RAG_PLANNER_THINKING=false
RAG_ALLOW_PLANNER_THINKING=false
RAG_PLANNER_TOKEN_BUDGET=4096
RAG_PLANNER_TIMEOUT_SECONDS=120
RAG_PLANNER_BASE_URL=

# Optional explicit paths when secrets/certificates live outside this checkout.
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
REDIS_PASSWORD_FILE=./deploy/secrets/redis_password
REDIS_EXPORTER_PASSWORD_FILE=./deploy/secrets/redis_exporter_passwords.json
GRAFANA_ADMIN_PASSWORD_FILE=./deploy/secrets/grafana_admin_password
APP_SECRET_KEY_FILE=./deploy/secrets/app_secret_key
