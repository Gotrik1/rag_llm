# Public endpoints. Keep databases and telemetry backends on the internal network.
RAG_HTTP_PORT=8080
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
CORS_ALLOW_ORIGIN=https://rag.example.com

# Compose secret files. Copy the matching *.example file, replace its contents,
# and keep the resulting un-suffixed file out of version control.
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
REDIS_PASSWORD_FILE=./deploy/secrets/redis_password
GRAFANA_ADMIN_PASSWORD_FILE=./deploy/secrets/grafana_admin_password
APP_SECRET_KEY_FILE=./deploy/secrets/app_secret_key

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=2gb

# Authentication is fail-closed in production. Set these to the corporate IdP.
RAG_AUTH_MODE=oidc
RAG_OIDC_ISSUER=https://login.example.com/realms/company
RAG_OIDC_AUDIENCE=rag-api
RAG_OIDC_JWKS_URL=https://login.example.com/realms/company/protocol/openid-connect/certs
RAG_OIDC_ROLE_CLAIM=roles
RAG_OIDC_PERMISSION_CLAIM=permissions
BOOTSTRAP_SUPERADMIN_SUBJECT=replace-with-initial-admin-subject

# RAG dependencies. Ollama is provided by the optional local-llm profile.
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
OLLAMA_PORT=11434

# Runtime sizing.
WEB_CONCURRENCY=2
INGESTION_WORKERS=2
RAG_LOG_LEVEL=INFO

# Retention defaults. Loki and Tempo retention are documented in deploy/README.md.
RAG_AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_INTERVAL_SECONDS=86400
METRICS_RETENTION=30d
