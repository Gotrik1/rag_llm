# Local process connection. The backend container builds its own URL via the postgres service name.
DATABASE_URL=postgresql://rag:ragpassword@127.0.0.1:5432/rag_assistant
POSTGRES_DB=rag_assistant
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpassword
POSTGRES_PORT=5432
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=5173
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434
# Default: use Ollama running on the host. For the optional Ollama profile use http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:14b
# Exact Redis response-cache TTL. The Compose default is seven days.
RESPONSE_CACHE_TTL_SECONDS=604800
