FROM rust:1.88-bookworm AS rust-builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RUST_CLI_PATH=/usr/local/bin/llm-rust
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libglib2.0-0 libgl1 ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY certs/ /usr/local/share/ca-certificates/gigachat/
RUN set -eux; \
    for certificate in /usr/local/share/ca-certificates/gigachat/*.cer; do \
        case "$certificate" in *gost*) continue ;; esac; \
        target="${certificate%.cer}.crt"; \
        if grep -q -- "-----BEGIN CERTIFICATE-----" "$certificate"; then \
            cp "$certificate" "$target"; \
        else \
            openssl x509 -inform DER -in "$certificate" -out "$target"; \
        fi; \
    done; \
    update-ca-certificates; \
    rm -rf /usr/local/share/ca-certificates/gigachat
ENV GIGACHAT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
COPY requirements.docker.txt ./
RUN pip install --no-cache-dir -r requirements.docker.txt
COPY --from=rust-builder /src/target/release/llm-rust /usr/local/bin/llm-rust
COPY . ./
EXPOSE 8080
CMD ["sh", "-c", "python -m alembic upgrade head && python -c 'from db_store import run_migrations; run_migrations()' && exec uvicorn asgi_app:app --host 0.0.0.0 --port 8080 --no-server-header"]
