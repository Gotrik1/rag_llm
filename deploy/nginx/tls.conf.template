upstream rag_frontend {
    server proxy:8080;
    keepalive 32;
}

server {
    listen 8443 ssl;
    server_name ${RAG_SERVER_NAME};
    server_tokens off;
    client_max_body_size 100m;

    ssl_certificate /etc/nginx/tls/rag.crt;
    ssl_certificate_key /etc/nginx/tls/rag.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:rag_tls:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        auth_basic "RAG Assistant";
        auth_basic_user_file /run/secrets/gateway_htpasswd;

        proxy_pass http://rag_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Basic Auth belongs to this edge only. Forwarding it would make the
        # application identity provider interpret it as its own bearer token
        # and return 401, causing browsers to challenge on every API request.
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }
}
